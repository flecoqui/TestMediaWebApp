{
  "compilerOptions": {
    "module": "ESNext",
    "rootDir": "ts",
    "target": "ES5",
    "downlevelIteration": true,
    "ignoreDeprecations": "6.0",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "outDir": "./dist/",
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "bundler",
    "types": [
      "jquery"
    ],
    "resolveJsonModule": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": true,
  },
  "include":[ 
    "ts/**/*"
  ],
}
